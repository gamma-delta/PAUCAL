{
  "schemaVersion": 1,
  "id": "paucal",
  "version": "${version}",
  "name": "PAUCAL",
  "description": "Petrak@'s Assorted, Useful Collection of Assistance Library.",
  "authors": [
    "petrak@ (aka gamma-delta)"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/paucal",
    "sources": "https://github.com/gamma-delta/PAUCAL"
  },

  "license": "MIT",
  "icon": "logo.png", "environment": "*",

  "entrypoints": {
    "main": [
      "at.petrak.paucal.fabric.FabricPaucalInit"
    ],
    "client": [
      "at.petrak.paucal.fabric.FabricPaucalClientInit"
    ],
    "modmenu": [
      "at.petrak.paucal.fabric.interop.ModMenuInterop"
    ]
  },
  "mixins": [
    "paucal.mixins.json"
  ],
  "depends": {
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "architectury": ">=${architectury_version}"
  },
  "suggests": {
    "another-mod": "*"
  }
}
